<Project Sdk="Microsoft.NET.Sdk">
  <!--
    BenchmarkDotNet harness for the doc/xls/ppt converters. Not a test project:
    CI runs `dotnet test UnitTests`, so this never adds to the test gate.
    How to run: see docs/perf/baseline.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Doc\b2xtranslator.doc.csproj" />
    <ProjectReference Include="..\Xls\b2xtranslator.xls.csproj" />
    <ProjectReference Include="..\Ppt\b2xtranslator.ppt.csproj" />
  </ItemGroup>
</Project>
